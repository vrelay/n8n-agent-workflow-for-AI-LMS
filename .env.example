# OpenRouter key used by the Homework Helper workflow (HTTP node reads $env.OPENROUTER_API_KEY)
OPENROUTER_API_KEY=

# Postgres (defaults are fine for local dev)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n

# n8n runs from source (./n8n) and connects to the Docker Postgres on localhost
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n

# n8n
# Required for a persistent volume: set once and keep it secret.
# If left empty, n8n generates one on first run (stored in ~/.n8n).
N8N_ENCRYPTION_KEY=

N8N_HOST=localhost
N8N_SECURE_COOKIE=false
# Allow {{ $env.VAR }} in workflow expressions (blocked by default in recent n8n)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Kolkata
