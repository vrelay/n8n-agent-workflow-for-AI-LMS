# OpenRouter key used by the Homework Helper workflow (HTTP node reads $env.OPENROUTER_API_KEY)
OPENROUTER_API_KEY=

# Google Gemini key for HTTP workflows (HTTP node reads $env.GEMINI_API_KEY)
# Also exposed as GOOGLE_GENERATIVE_AI_API_KEY for n8n Google/Gemini integrations.
GEMINI_API_KEY=

# Postgres (defaults are fine for local dev)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n

# Used only if you run n8n on the host (pnpm start) against Docker Postgres.
# Inside Compose, DB_POSTGRESDB_HOST is set to `postgres` automatically.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n

# n8n
# Tag for the locally built image (ai-lms/n8n:$N8N_VERSION) from ./n8n
N8N_VERSION=2.34.4

# Required for a persistent volume: set once and keep it secret.
# If left empty, n8n generates one on first run (stored in the n8n_data volume).
N8N_ENCRYPTION_KEY=

N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
# Allow {{ $env.VAR }} in workflow expressions (blocked by default in recent n8n)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Kolkata
